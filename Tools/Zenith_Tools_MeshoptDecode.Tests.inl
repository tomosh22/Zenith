// ★ THE REFUSALS. Every one of these is a case where returning false is the
// contract and returning true with a filled buffer would corrupt a mesh silently.
ZENITH_TEST(MeshoptDecode, RefusesUnsupportedVertexCodecVersion)
{
	std::vector<unsigned char> xOut(ulMESHOPT_VERTEX_COUNT * ulMESHOPT_VERTEX_STRIDE, 0xCDu);
	ZENITH_ASSERT_FALSE(Zenith_Tools_MeshoptDecode::DecodeVertexBuffer(
		xOut.data(), ulMESHOPT_VERTEX_COUNT, ulMESHOPT_VERTEX_STRIDE,
		auMESHOPT_VERTEX_V1_ENCODED, sizeof(auMESHOPT_VERTEX_V1_ENCODED)),
		"vertex codec version 1 must be REFUSED, not decoded as if it were version 0");
}

ZENITH_TEST(MeshoptDecode, RefusesMalformedHeadersAndTruncation)
{
	std::vector<unsigned char> xOut(ulMESHOPT_VERTEX_COUNT * ulMESHOPT_VERTEX_STRIDE, 0u);

	// A header byte from the wrong family.
	std::vector<unsigned char> xBadFamily(
		auMESHOPT_VERTEX_ENCODED,
		auMESHOPT_VERTEX_ENCODED + sizeof(auMESHOPT_VERTEX_ENCODED));
	xBadFamily[0] = 0x10u;
	ZENITH_ASSERT_FALSE(Zenith_Tools_MeshoptDecode::DecodeVertexBuffer(
		xOut.data(), ulMESHOPT_VERTEX_COUNT, ulMESHOPT_VERTEX_STRIDE,
		xBadFamily.data(), xBadFamily.size()),
		"a non-vertex header byte must be refused");

	// Truncated to a third: the group walk must run out of input and say so
	// rather than reading past the end.
	ZENITH_ASSERT_FALSE(Zenith_Tools_MeshoptDecode::DecodeVertexBuffer(
		xOut.data(), ulMESHOPT_VERTEX_COUNT, ulMESHOPT_VERTEX_STRIDE,
		auMESHOPT_VERTEX_ENCODED, sizeof(auMESHOPT_VERTEX_ENCODED) / 3),
		"a truncated vertex stream must be refused");

	// A vertex size the codec never emits (it requires a 4-byte multiple).
	ZENITH_ASSERT_FALSE(Zenith_Tools_MeshoptDecode::DecodeVertexBuffer(
		xOut.data(), ulMESHOPT_VERTEX_COUNT, 13u,
		auMESHOPT_VERTEX_ENCODED, sizeof(auMESHOPT_VERTEX_ENCODED)),
		"a non-4-byte-multiple vertex size must be refused");

	std::vector<unsigned int> xIndices(ulMESHOPT_INDEX_COUNT, 0u);
	ZENITH_ASSERT_FALSE(Zenith_Tools_MeshoptDecode::DecodeIndexBuffer(
		xIndices.data(), ulMESHOPT_INDEX_COUNT - 1u,
		auMESHOPT_INDEX_ENCODED, sizeof(auMESHOPT_INDEX_ENCODED)),
		"an index count that is not a multiple of 3 must be refused");

	ZENITH_ASSERT_FALSE(Zenith_Tools_MeshoptDecode::DecodeIndexBuffer(
		xIndices.data(), ulMESHOPT_INDEX_COUNT,
		auMESHOPT_INDEX_ENCODED, 8u),
		"an index stream too short to hold its own codeaux table must be refused");
}

ZENITH_TEST(MeshoptDecode, FilterNamesRoundTripAndUnknownIsRefused)
{
	Zenith_Tools_MeshoptDecode::MESHOPT_FILTER eFilter =
		Zenith_Tools_MeshoptDecode::MESHOPT_FILTER_EXPONENTIAL;

	ZENITH_ASSERT_TRUE(Zenith_Tools_MeshoptDecode::ParseFilterName(nullptr, eFilter),
		"an absent filter is legal and means NONE");
	ZENITH_ASSERT_EQ((int)eFilter, (int)Zenith_Tools_MeshoptDecode::MESHOPT_FILTER_NONE,
		"absent -> NONE");

	ZENITH_ASSERT_TRUE(Zenith_Tools_MeshoptDecode::ParseFilterName("OCTAHEDRAL", eFilter), "OCTAHEDRAL parses");
	ZENITH_ASSERT_EQ((int)eFilter, (int)Zenith_Tools_MeshoptDecode::MESHOPT_FILTER_OCTAHEDRAL, "OCTAHEDRAL");

	ZENITH_ASSERT_TRUE(Zenith_Tools_MeshoptDecode::ParseFilterName("QUATERNION", eFilter), "QUATERNION parses");
	ZENITH_ASSERT_EQ((int)eFilter, (int)Zenith_Tools_MeshoptDecode::MESHOPT_FILTER_QUATERNION, "QUATERNION");

	ZENITH_ASSERT_TRUE(Zenith_Tools_MeshoptDecode::ParseFilterName("EXPONENTIAL", eFilter), "EXPONENTIAL parses");
	ZENITH_ASSERT_EQ((int)eFilter, (int)Zenith_Tools_MeshoptDecode::MESHOPT_FILTER_EXPONENTIAL, "EXPONENTIAL");

	// ★ A FILTER THIS BUILD DOES NOT KNOW MUST FAIL LOUDLY. Falling back to NONE
	// would leave the stream unfiltered and the mesh quietly wrong -- exactly the
	// failure a future extension revision would introduce.
	ZENITH_ASSERT_FALSE(
		Zenith_Tools_MeshoptDecode::ParseFilterName("SOMETHING_NEW", eFilter),
		"an unknown filter name must be refused, never treated as NONE");

	// A stride the filter cannot express is a no-op refusal, not a scribble.
	unsigned char auScratch[16] = {};
	ZENITH_ASSERT_FALSE(Zenith_Tools_MeshoptDecode::ApplyFilter(
		auScratch, 2u, 6u, Zenith_Tools_MeshoptDecode::MESHOPT_FILTER_OCTAHEDRAL),
		"OCTAHEDRAL must refuse a 6-byte stride");
	ZENITH_ASSERT_TRUE(Zenith_Tools_MeshoptDecode::ApplyFilter(
		auScratch, 2u, 6u, Zenith_Tools_MeshoptDecode::MESHOPT_FILTER_NONE),
		"NONE is always a legal no-op");
}
