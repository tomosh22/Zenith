	// Byte-compare with a diagnostic that names the FIRST offset that differs,
	// because "the buffers are not equal" over 636 bytes is not something anyone
	// can act on.
	bool MeshoptBytesEqual(
		const unsigned char* pGot, const unsigned char* pExpected, size_t ulSize,
		size_t& ulFirstDiffOut)
	{
		for (size_t i = 0; i < ulSize; ++i)
		{
			if (pGot[i] != pExpected[i])
			{
				ulFirstDiffOut = i;
				return false;
			}
		}
		ulFirstDiffOut = ulSize;
		return true;
	}
}

ZENITH_TEST(MeshoptDecode, VertexCodecMatchesReference)
{
	std::vector<unsigned char> xOut(ulMESHOPT_VERTEX_COUNT * ulMESHOPT_VERTEX_STRIDE, 0u);
	const bool bOk = Zenith_Tools_MeshoptDecode::DecodeVertexBuffer(
		xOut.data(), ulMESHOPT_VERTEX_COUNT, ulMESHOPT_VERTEX_STRIDE,
		auMESHOPT_VERTEX_ENCODED, sizeof(auMESHOPT_VERTEX_ENCODED));
	ZENITH_ASSERT_TRUE(bOk, "the reference-encoded vertex stream must decode");

	size_t ulFirstDiff = 0;
	const bool bEqual = MeshoptBytesEqual(
		xOut.data(), auMESHOPT_VERTEX_EXPECTED, xOut.size(), ulFirstDiff);
	ZENITH_ASSERT_TRUE(bEqual,
		"vertex decode must be byte-identical to meshoptimizer; first difference at "
		"byte %zu (got 0x%02x, expected 0x%02x)",
		ulFirstDiff,
		(u_int)(bEqual ? 0u : xOut[ulFirstDiff]),
		(u_int)(bEqual ? 0u : auMESHOPT_VERTEX_EXPECTED[ulFirstDiff]));
}

ZENITH_TEST(MeshoptDecode, IndexCodecMatchesReference)
{
	std::vector<unsigned int> xOut(ulMESHOPT_INDEX_COUNT, 0u);
	const bool bOk = Zenith_Tools_MeshoptDecode::DecodeIndexBuffer(
		xOut.data(), ulMESHOPT_INDEX_COUNT,
		auMESHOPT_INDEX_ENCODED, sizeof(auMESHOPT_INDEX_ENCODED));
	ZENITH_ASSERT_TRUE(bOk, "the reference-encoded index stream must decode");

	size_t ulFirstDiff = ulMESHOPT_INDEX_COUNT;
	for (size_t i = 0; i < ulMESHOPT_INDEX_COUNT; ++i)
	{
		if (xOut[i] != auMESHOPT_INDEX_EXPECTED[i])
		{
			ulFirstDiff = i;
			break;
		}
	}
	ZENITH_ASSERT_EQ(ulFirstDiff, ulMESHOPT_INDEX_COUNT,
		"index decode must match meshoptimizer exactly; first difference at index "
		"%zu (got %u, expected %u)",
		ulFirstDiff,
		ulFirstDiff < ulMESHOPT_INDEX_COUNT ? xOut[ulFirstDiff] : 0u,
		ulFirstDiff < ulMESHOPT_INDEX_COUNT ? auMESHOPT_INDEX_EXPECTED[ulFirstDiff] : 0u);
}

ZENITH_TEST(MeshoptDecode, ExponentialFilterMatchesReference)
{
	std::vector<unsigned char> xOut(
		ulMESHOPT_EXPFILTER_COUNT * ulMESHOPT_EXPFILTER_STRIDE, 0u);
	ZENITH_ASSERT_TRUE(Zenith_Tools_MeshoptDecode::DecodeVertexBuffer(
		xOut.data(), ulMESHOPT_EXPFILTER_COUNT, ulMESHOPT_EXPFILTER_STRIDE,
		auMESHOPT_EXPFILTER_ENCODED, sizeof(auMESHOPT_EXPFILTER_ENCODED)),
		"the filtered stream must clear the vertex codec first");

	ZENITH_ASSERT_TRUE(Zenith_Tools_MeshoptDecode::ApplyFilter(
		xOut.data(), ulMESHOPT_EXPFILTER_COUNT, ulMESHOPT_EXPFILTER_STRIDE,
		Zenith_Tools_MeshoptDecode::MESHOPT_FILTER_EXPONENTIAL),
		"EXPONENTIAL must accept a 12-byte stride");

	size_t ulFirstDiff = 0;
	const bool bEqual = MeshoptBytesEqual(
		xOut.data(), auMESHOPT_EXPFILTER_EXPECTED, xOut.size(), ulFirstDiff);
	ZENITH_ASSERT_TRUE(bEqual,
		"codec + EXPONENTIAL filter must match meshoptimizer's decodeGltfBuffer; "
		"first difference at byte %zu", ulFirstDiff);
}

