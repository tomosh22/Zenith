###############################################################################
# Git LFS (MVP-0.3.3, added 2026-05-13)
#
# All binary asset types route through Git LFS instead of being stored inline
# in pack files. Reasons:
#   - GitHub has a 100 MB per-file commit limit (already bit us on
#     slang-llvm.dll = 105 MB, fetched per-CI-run today rather than tracked).
#   - Repo clones stay small for new contributors who don't need every
#     historical asset revision.
#   - Binary diffs are unreadable anyway -- LFS hashing them is a strict
#     win for git operations.
#
# Prerequisite: `git lfs install` must have run on the developer's machine
# AND on the CI runner. Tracked in ManualSetupChecklist section F.
#
# Patterns chosen per the MVP-0.3.3 roadmap entry. Add new binary asset
# extensions to this section when they appear; do NOT inline-track them.
###############################################################################
*.zmodel  filter=lfs diff=lfs merge=lfs -text
*.zskel   filter=lfs diff=lfs merge=lfs -text
*.zanim   filter=lfs diff=lfs merge=lfs -text
*.zmesh   filter=lfs diff=lfs merge=lfs -text
*.ztxtr   filter=lfs diff=lfs merge=lfs -text
*.zaudio  filter=lfs diff=lfs merge=lfs -text
*.spv     filter=lfs diff=lfs merge=lfs -text
*.fbx     filter=lfs diff=lfs merge=lfs -text
*.png     filter=lfs diff=lfs merge=lfs -text
*.jpg     filter=lfs diff=lfs merge=lfs -text
*.jpeg    filter=lfs diff=lfs merge=lfs -text
*.tga     filter=lfs diff=lfs merge=lfs -text
*.dds     filter=lfs diff=lfs merge=lfs -text
*.exr     filter=lfs diff=lfs merge=lfs -text
*.hdr     filter=lfs diff=lfs merge=lfs -text
*.wav     filter=lfs diff=lfs merge=lfs -text
*.ogg     filter=lfs diff=lfs merge=lfs -text
*.mp3     filter=lfs diff=lfs merge=lfs -text

###############################################################################
# Deliberate carve-out from the "route every binary asset through LFS" rule
# above (ZM-D-147).
#
# .znavmesh and .zscen are tracked INLINE, not through LFS, because they are
# the two asset families the build system commits on purpose:
#   - they are small (a Zenithmon scene is 1.8-27 KB; the Dawnmere navmesh is
#     ~365 KB) and deterministic, so they neither bloat packs nor churn;
#   - CI must be able to read them on a plain checkout with no `git lfs`
#     prerequisite -- that is the whole reason they are committed, since a
#     baked navmesh is loadable with no GPU and no terrain.
# They are still BINARY: marked so here, or `* text=auto` at the top of this
# file would corrupt them by normalising CRLF byte pairs inside float data.
#
# This carve-out does NOT reopen the LFS question for HEAVY assets (terrain is
# ~4.3 GB across the games and stays gitignored pre-LFS) -- that remains a
# logged user decision.
###############################################################################
*.znavmesh binary
*.zscen    binary
*.flac    filter=lfs diff=lfs merge=lfs -text
*.gltf    filter=lfs diff=lfs merge=lfs -text
*.glb     filter=lfs diff=lfs merge=lfs -text
*.obj     filter=lfs diff=lfs merge=lfs -text
*.blend   filter=lfs diff=lfs merge=lfs -text

# --- Flux shader-compiler generated headers (shader-validation gate) ------------
# The Generated/*.h are LF as FluxCompiler emits them, but `* text=auto` above lets
# a fresh checkout on an autocrlf=true runner smudge them to CRLF; FluxCompiler then
# rewrites them LF, so `git status` reports them spuriously "modified" and fails the
# gate. Pin them to LF so the regenerated tree stays byte-clean on every checkout.
# (The .spv themselves are Git-LFS tracked -- see *.spv above; that gate failure is
# fixed by fetching LFS in the workflow checkout, not here.)
Zenith/Flux/Shaders/Generated/*.h  text eol=lf
